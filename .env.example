# Contraseña de acceso a la app. OBLIGATORIA: el servidor no arranca sin ella.
# En Coolify: Environment Variables -> APP_PASSWORD
APP_PASSWORD=cambia-esta-contrasena

# Secreto para firmar la cookie de sesión. Opcional pero recomendado.
# Si no lo defines se genera uno y se guarda en la base de datos.
# Cambiarlo cierra la sesión en todos los dispositivos.
# Generar con: openssl rand -hex 32
SESSION_SECRET=

# ---------- Base de datos ----------
# Postgres. Si está definida se usa en lugar de SQLite.
# DATABASE_URL=postgres://usuario:clave@host:5432/nova
# TLS: require (sin validar certificado, típico en RDS) | verify | false.
# Si lo usas, no pongas sslmode en la URL.
# DATABASE_SSL=require

# Archivo SQLite. Se usa cuando no hay DATABASE_URL y, con Postgres, es de
# donde se importan los datos la primera vez que la base está vacía.
DB_PATH=/data/nova.db
# SQLITE_IMPORT_PATH=/ruta/a/otro.db

# ---------- Sincronización con Meta (vía Claude) ----------
# Clave que usa Claude para leer solicitudes y enviar resultados.
# No es la API de Meta. Generar con: openssl rand -hex 32
# SYNC_TOKEN=

# Solo en tu máquina (para /sync-meta en Claude Code), no en Coolify:
# NOVA_URL=https://ads.tu-dominio.com
# SYNC_USD_PEN=3.75

# ---------- Imágenes en S3 ----------
# Si S3_BUCKET está definido, las imágenes del banco se guardan en el bucket
# (privado: la app las sirve con la sesión). Si no, van dentro de la base.
# S3_BUCKET=nova-ads-studio
# S3_REGION=us-east-1
# S3_PREFIX=nova
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Solo para servicios compatibles con S3 (MinIO, R2, Spaces…):
# S3_ENDPOINT=https://minio.tu-dominio.com
# S3_FORCE_PATH_STYLE=true

# Puerto del servidor.
PORT=3000

# Forzar cookie "secure". Normalmente no hace falta: se detecta solo
# a través del proxy. Ponlo en true si sirves por HTTPS y no persiste la sesión.
# COOKIE_SECURE=true
